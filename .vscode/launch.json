{
    "configurations": [

        {
            "name": "Python Debugger: clipper.py (Launch)",
            "type": "debugpy",
            "request": "launch",
            "program": "clipper.py",
            "console": "integratedTerminal",
            "args": [
                "--config",
                "config.json",
                "--verbose"
            ]
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        }
    ]
}